{
	"compilerOptions": {
		"baseUrl": ".",
		"strict": true,
		"noImplicitOverride": true,
		"target": "ES2018",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "ES2018"],
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": false
	},
	"include": ["main.ts", "src/**/*.ts", "vitest.config.ts"]
}
